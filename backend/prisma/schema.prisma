generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}
enum TitleType {
  MOVIE
  SERIES
}
enum SourceKind {
  HLS_OWNED
  PUBLIC_DOMAIN
  YOUTUBE_OFFICIAL
  WATCH_LINK
  EMBED_PROVIDER
}
enum SourceStatus {
  UPLOADING
  PROCESSING
  READY
  FAILED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String?
  name         String?
  role         Role     @default(USER)
  /// Set once the user follows the link in the verification email (or resets their password via email).
  emailVerifiedAt DateTime?
  createdAt    DateTime @default(now())
  watchlist    WatchlistItem[]
  history      WatchHistory[]
  ratings      Rating[]
  profiles     Profile[]
  refreshTokens RefreshToken[]
  notifications Notification[]
  reminders    Reminder[]
  reports      SourceReport[]
  requests     TitleRequest[]
  requestVotes TitleRequestVote[]
  lists        UserList[]
  emailTokens  EmailToken[]
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  revokedAt DateTime?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model Title {
  id           String    @id @default(cuid())
  slug         String    @unique
  tmdbId       Int?      @unique
  type         TitleType
  name         String
  overview     String?
  year         Int?
  runtimeMin   Int?
  rating       String?
  posterPath   String?
  backdropPath String?
  posterCredit String?
  /// YouTube video id of the official trailer (TMDB), used for hero and hover previews.
  trailerKey   String?
  /// TMDB cast and crew: { cast: [{ name, character, profilePath }], crew: [{ name, job, profilePath }] }.
  credits      Json?
  backdropCredit String?
  accent       String[]
  releaseDate  DateTime?
  genres       String[]
  /// TMDB original_language (ISO 639-1), e.g. "hi", "ta", "en".
  language     String?
  /// TMDB popularity and vote count; the main ranking signal for home rows.
  popularity   Float     @default(0)
  voteCount    Int       @default(0)
  published    Boolean   @default(false)
  createdAt    DateTime  @default(now())
  sources      Source[]
  episodes     Episode[]
  watchlist    WatchlistItem[]
  history      WatchHistory[]
  ratings      Rating[]
  notifications Notification[]
  reminders    Reminder[]
  reports      SourceReport[]
  listItems    UserListItem[]
  @@index([published, createdAt])
  @@index([published, language])
  @@index([published, popularity])
}

model Episode {
  id      String  @id @default(cuid())
  titleId String
  season  Int
  number  Int
  name    String?
  overview   String?
  /// TMDB still path (bare, e.g. "/abc.jpg").
  stillPath  String?
  runtimeMin Int?
  /// Playback markers in seconds from the start, set by an admin. Intro skipping only appears when both intro fields are set.
  introStartSec  Int?
  introEndSec    Int?
  /// Where the end credits begin; the "Next episode" card appears from here.
  creditsStartSec Int?
  title   Title   @relation(fields: [titleId], references: [id], onDelete: Cascade)
  sources Source[]
  @@unique([titleId, season, number])
}

model Source {
  id          String       @id @default(cuid())
  titleId     String?
  episodeId   String?
  kind        SourceKind
  label       String
  priority    Int          @default(0)
  manifestKey String?
  externalUrl String?
  status      SourceStatus @default(READY)
  title       Title?       @relation(fields: [titleId], references: [id], onDelete: Cascade)
  episode     Episode?     @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  @@index([titleId])
  @@index([episodeId])
}

model EmbedProvider {
  id                 String  @id @default(cuid())
  slug               String  @unique
  label              String
  urlTemplate        String
  episodeUrlTemplate String?
  licenseRef         String
  /// ISO 639-1 codes of the audio/subtitle languages this server offers, e.g. ["en","hi"].
  languages          String[] @default([])
  enabled            Boolean @default(false)
  priority           Int     @default(0)
}

/// Embed hosts added from the admin panel; merged with EMBED_ALLOWED_HOSTS.
model AllowedHost {
  host      String   @id
  createdAt DateTime @default(now())
}

/// Netflix-style viewer profile under an account. Watchlist, history and ratings are scoped to a profile
/// via `profileId`; "" marks legacy rows from before profiles and is adopted by the first profile created.
/// (profileId is a plain string, not an FK, so those legacy rows stay valid.)
model Profile {
  id        String   @id @default(cuid())
  userId    String
  name      String
  avatar    String   @default("0")
  isKids    Boolean  @default(false)
  /// Playback preferences (see src/me/profile-prefs.ts); null = defaults.
  prefs     Json?
  /// argon2 hash of a 4-digit PIN; when set, using the profile needs a short-lived token from verify-pin.
  pinHash   String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model WatchlistItem {
  userId  String
  profileId String @default("")
  titleId String
  addedAt DateTime @default(now())
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title   Title    @relation(fields: [titleId], references: [id], onDelete: Cascade)
  @@id([userId, profileId, titleId])
}

model WatchHistory {
  id          String   @id @default(cuid())
  userId      String
  profileId   String   @default("")
  titleId     String
  episodeId   String   @default("")
  positionSec Int
  durationSec Int
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       Title    @relation(fields: [titleId], references: [id], onDelete: Cascade)
  @@unique([userId, profileId, titleId, episodeId])
}

/// Thumbs up (1) or down (-1); feeds the personalized home rows.
model Rating {
  userId    String
  profileId String   @default("")
  titleId   String
  value     Int
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     Title    @relation(fields: [titleId], references: [id], onDelete: Cascade)
  @@id([userId, profileId, titleId])
}

enum NotificationType {
  SOURCE_ADDED
  EPISODE_ADDED
  RELEASED
  REQUEST_FULFILLED
}

/// In-app notification for one profile ("" = every profile of the user).
model Notification {
  id        String           @id @default(cuid())
  userId    String
  profileId String           @default("")
  type      NotificationType
  titleId   String
  message   String
  readAt    DateTime?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     Title            @relation(fields: [titleId], references: [id], onDelete: Cascade)
  @@index([userId, profileId, createdAt])
  @@index([titleId, type, createdAt])
}

/// "Remind me" on a coming-soon title; notified once when the release date passes.
model Reminder {
  userId     String
  profileId  String   @default("")
  titleId    String
  createdAt  DateTime @default(now())
  notifiedAt DateTime?
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      Title    @relation(fields: [titleId], references: [id], onDelete: Cascade)
  @@id([userId, profileId, titleId])
}

/// A viewer's "this source is broken" report. `sourceKey` is a Source id, or `provider:<slug>` for registry embeds.
/// `episodeKey` is "" for movies or "S1E2". One report per user per source/episode; reporting again reopens it.
model SourceReport {
  id         String    @id @default(cuid())
  userId     String
  titleId    String
  sourceKey  String
  episodeKey String    @default("")
  reason     String    @default("BROKEN")
  note       String?
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      Title     @relation(fields: [titleId], references: [id], onDelete: Cascade)
  @@unique([userId, titleId, sourceKey, episodeKey])
  @@index([titleId, sourceKey, createdAt])
  @@index([resolvedAt, createdAt])
}

enum RequestStatus {
  OPEN
  ADDED
  REJECTED
}

/// "Please add this title." Votes decide the order admins work through them.
model TitleRequest {
  id        String        @id @default(cuid())
  userId    String
  name      String
  type      TitleType
  tmdbId    Int?
  note      String?
  status    RequestStatus @default(OPEN)
  /// Set when an admin marks the request ADDED.
  titleId   String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  votes     TitleRequestVote[]
  @@index([status, createdAt])
}

model TitleRequestVote {
  requestId String
  userId    String
  createdAt DateTime     @default(now())
  request   TitleRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([requestId, userId])
}

/// Custom list beyond the single My List ("Weekend picks"). Scoped to a profile like the watchlist.
model UserList {
  id          String         @id @default(cuid())
  userId      String
  profileId   String         @default("")
  name        String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items       UserListItem[]
  @@index([userId, profileId])
}

model UserListItem {
  listId  String
  titleId String
  addedAt DateTime @default(now())
  list    UserList @relation(fields: [listId], references: [id], onDelete: Cascade)
  title   Title    @relation(fields: [titleId], references: [id], onDelete: Cascade)
  @@id([listId, titleId])
  @@index([titleId])
}

enum EmailTokenKind {
  VERIFY
  RESET
}

/// One-time link token sent by email. Only the SHA-256 hash is stored.
model EmailToken {
  id        String         @id @default(cuid())
  userId    String
  kind      EmailTokenKind
  tokenHash String         @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime       @default(now())
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, kind, createdAt])
}
